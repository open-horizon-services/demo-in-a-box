#cloud-config
# Agent VM cloud-init template (basic provisioning only).
# Rendered at launch time by the Makefile using envsubst.
# Substitution tokens: ${HUB_IP}, ${AGENT_NUM}
# Agent installation is handled by install-agent.sh after credentials are copied.

package_update: true
package_upgrade: false

packages:
  - docker.io
  - curl
  - jq
  - net-tools

runcmd:
  # ── Enable and start Docker ──────────────────────────────────────────────
  - systemctl enable docker
  - systemctl start docker

  # ── Configure Docker insecure registry for hub (${HUB_IP}:5000) ──────────
  - mkdir -p /etc/docker
  - |
    if [ -f /etc/docker/daemon.json ] && [ -s /etc/docker/daemon.json ]; then
      cp /etc/docker/daemon.json /etc/docker/daemon.json.backup
      if command -v jq >/dev/null 2>&1; then
        jq '. + {"insecure-registries": ["${HUB_IP}:5000"]}' /etc/docker/daemon.json \
          > /etc/docker/daemon.json.tmp
        mv /etc/docker/daemon.json.tmp /etc/docker/daemon.json
      else
        sed -i 's/}$/,"insecure-registries": ["${HUB_IP}:5000"]}/' /etc/docker/daemon.json
      fi
    else
      printf '{\n  "insecure-registries": ["%s:5000"]\n}\n' "${HUB_IP}" > /etc/docker/daemon.json
    fi
  - systemctl restart docker
  - |
    for i in \$(seq 1 30); do
      if docker info >/dev/null 2>&1; then
        echo "✓ Docker restarted"
        break
      fi
      if [ "\$i" -eq 30 ]; then
        echo "ERROR: Docker failed to restart" >&2
        exit 1
      fi
      sleep 2
    done
  - echo "✓ Cloud-init complete - Docker ready (agent ${AGENT_NUM})"
  - echo "✓ Agent installation will be triggered by Makefile after credential sync"
