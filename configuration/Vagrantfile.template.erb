Vagrant.configure("2") do |config|
  <% 
    network_prefix = ENV.fetch('NETWORK_PREFIX', '192.168.56')
    hub_ip = ENV.fetch('HUB_IP', "#{network_prefix}.10")
  %>
  <% (1..num_agents.to_i).each do |i| %>
    config.vm.define "agent<%= i %>" do |agent<%= i %>|
      # Use agent-specific box (allows mixed OS)
      agent<%= i %>.vm.box = ENV.fetch('AGENT_BOX_NAME', 'demo-in-a-box/ubuntu-jammy-horizon')
      # Only set box_version for date-like versions (for base box pinning)
      box_version = ENV.fetch('BOX_VERSION', '1.0.0')
      if box_version.start_with?('20')
        agent<%= i %>.vm.box_version = box_version
      end
      agent<%= i %>.vm.disk :disk, size: "<%= disk_size %>GB", primary: true
      agent<%= i %>.vm.network :private_network, ip: "<%= network_prefix %>.<%= base_ip.to_i + (i-1)*10 %>"
      agent<%= i %>.vm.provider "virtualbox" do |vb|
        vb.memory = "<%= memory %>"
        vb.linked_clone = true
      end
      agent<%= i %>.vm.hostname = "agent<%= i %>"
      agent<%= i %>.vm.provision "shell", inline: <<-SHELL
      HUB_IP="<%= hub_ip %>"
      
      # Detect OS type
      . /etc/os-release
      OS_ID=$ID
      
      echo "==> Agent <%= i %> detected OS: $OS_ID"
      
      touch agent-install.crt
      export HZN_ORG_ID=<%= hzn_org_id %>
      export HZN_EXCHANGE_USER_AUTH=<%= hzn_exchange_user_auth %>
      export HZN_EXCHANGE_URL=http://${HUB_IP}:3090/v1
      export HZN_FSS_CSSURL=http://${HUB_IP}:9443/
      export HZN_AGBOT_URL=http://${HUB_IP}:3111
      export HZN_FDO_SVC_URL=http://${HUB_IP}:9008/api
      echo "HZN_ORG_ID=<%= hzn_org_id %>" > agent-install.cfg
      echo "HZN_EXCHANGE_USER_AUTH=<%= hzn_exchange_user_auth %>" >> agent-install.cfg
      echo "HZN_EXCHANGE_URL=http://${HUB_IP}:3090/v1" >> agent-install.cfg
      echo "HZN_FSS_CSSURL=http://${HUB_IP}:9443/" >> agent-install.cfg
      echo "HZN_AGBOT_URL=http://${HUB_IP}:3111" >> agent-install.cfg
      echo "HZN_FDO_SVC_URL=http://${HUB_IP}:9008/api" >> agent-install.cfg
      export $(cat agent-install.cfg)
      curl -sSL https://raw.githubusercontent.com/open-horizon/anax/refs/heads/master/agent-install/agent-install.sh | bash -s -- -i anax: -k ./agent-install.cfg -c css: -p IBM/pattern-ibm.helloworld -w '*' -T 120
      
      # ===== Step 1.2: Agent Registry Configuration =====
      echo "==> Configuring insecure registry access to hub..."
      
      # Detect container runtime
      CONTAINER_RUNTIME=""
      if command -v docker >/dev/null 2>&1; then
        CONTAINER_RUNTIME="docker"
        echo "✓ Detected Docker runtime"
      elif command -v podman >/dev/null 2>&1; then
        CONTAINER_RUNTIME="podman"
        echo "✓ Detected Podman runtime"
      else
        echo "ERROR: No container runtime (Docker/Podman) found"
        exit 1
      fi
      
      # Configure insecure registry based on runtime
      if [ "$CONTAINER_RUNTIME" = "docker" ]; then
        echo "==> Configuring Docker insecure registry..."
        
        # Create Docker daemon config directory if it doesn't exist
        mkdir -p /etc/docker
        
        # Check if daemon.json exists and has content
        if [ -f /etc/docker/daemon.json ] && [ -s /etc/docker/daemon.json ]; then
          # Backup existing config
          cp /etc/docker/daemon.json /etc/docker/daemon.json.backup
          
          # Use jq to merge if available, otherwise manual merge
          if command -v jq >/dev/null 2>&1; then
            jq '. + {"insecure-registries": ["${HUB_IP}:5000"]}' /etc/docker/daemon.json > /etc/docker/daemon.json.tmp
            mv /etc/docker/daemon.json.tmp /etc/docker/daemon.json
          else
            # Simple append if no jq (assumes no existing insecure-registries)
            sed -i 's/}$/,"insecure-registries": ["${HUB_IP}:5000"]}/' /etc/docker/daemon.json
          fi
        else
          # Create new config
          cat > /etc/docker/daemon.json <<EOF
{
  "insecure-registries": ["${HUB_IP}:5000"]
}
EOF
        fi
        
        echo "✓ Docker daemon.json configured"
        
        # Restart Docker service
        echo "==> Restarting Docker service..."
        systemctl restart docker
        
        # Wait for Docker to be ready
        for i in {1..30}; do
          if docker info >/dev/null 2>&1; then
            echo "✓ Docker service restarted successfully"
            break
          fi
          if [ $i -eq 30 ]; then
            echo "ERROR: Docker failed to restart after configuration"
            exit 1
          fi
          sleep 2
        done
        
      elif [ "$CONTAINER_RUNTIME" = "podman" ]; then
        echo "==> Configuring Podman insecure registry..."
        
        # Create registries config directory if it doesn't exist
        mkdir -p /etc/containers
        
        # Backup existing config if it exists
        if [ -f /etc/containers/registries.conf ]; then
          cp /etc/containers/registries.conf /etc/containers/registries.conf.backup
        fi
        
        # Check if insecure registry already configured
        if ! grep -q "\\[\\[registry\\]\\]" /etc/containers/registries.conf 2>/dev/null || \
           ! grep -q "location = \"${HUB_IP}:5000\"" /etc/containers/registries.conf 2>/dev/null; then
          
          # Append insecure registry configuration
          cat >> /etc/containers/registries.conf <<EOF

# Hub registry for blessed samples (added by demo-in-a-box)
[[registry]]
location = "${HUB_IP}:5000"
insecure = true
EOF
          echo "✓ Podman registries.conf configured"
        else
          echo "✓ Podman insecure registry already configured"
        fi
        
        # Restart Podman service if it's running
        if systemctl is-active --quiet podman 2>/dev/null; then
          echo "==> Restarting Podman service..."
          systemctl restart podman
          echo "✓ Podman service restarted"
        fi
      fi
      
      echo "✓ Insecure registry configuration complete"
      
      echo "Verifying agent installation..."
      if ! command -v hzn >/dev/null 2>&1; then
        echo "ERROR: Agent CLI not available"
        exit 1
      fi
      echo "✓ Agent CLI installed"
      
      echo "Waiting for agent to start..."
      for i in {1..30}; do
        if hzn node list >/dev/null 2>&1; then
          echo "✓ Agent is running"
          break
        fi
        if [ $i -eq 30 ]; then
          echo "ERROR: Agent failed to start after 2.5 minutes"
          exit 1
        fi
        sleep 5
      done
      
      echo "Verifying Exchange connectivity..."
      if ! hzn exchange status >/dev/null 2>&1; then
        echo "ERROR: Cannot connect to Exchange"
        exit 1
      fi
      echo "✓ Exchange connectivity verified"
      
      echo "Agent provisioning complete and healthy"
      SHELL
    end
  <% end %>
end 