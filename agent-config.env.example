# Agent-only configuration for 'make up-agent'.
#
# Copy this file to agent-config.env (git-ignored) and fill in the values for
# your existing Open Horizon management hub, or point at another file with
# 'make up-agent AGENT_CONFIG=path/to/file.env'. An agent-install.cfg exported
# from your hub can also be used as-is.
#
# This file is copied into each agent VM as /root/mycreds.env.

# Required
export HZN_ORG_ID="myorg"
export HZN_EXCHANGE_USER_AUTH="admin:changeme"
export HZN_EXCHANGE_URL="http://192.168.1.50:3090/v1"
export HZN_FSS_CSSURL="http://192.168.1.50:9443/"

# Optional
export HZN_AGBOT_URL="http://192.168.1.50:3111"
export HZN_FDO_SVC_URL="http://192.168.1.50:9008/api"

# Optional: CA certificate for an HTTPS hub (path on this host). When unset,
# the certificate is fetched from the hub's CSS.
# export HZN_MGMT_HUB_CERT_PATH="./agent-install.crt"

# Optional: pattern to register the node with (must exist in the Exchange).
# Default: IBM/pattern-ibm.helloworld
# export HZN_NODE_PATTERN="IBM/pattern-ibm.helloworld"
